# OS junk
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Python
__pycache__/
*.py[cod]
*.pyc
*$py.class
*.egg-info/
.pytest_cache/

# Node
node_modules/

# Logs
*.log

# Cloudflare Wrangler local dev state (cache, not source)
.wrangler/state/

# SQLite runtime temp files (WAL/SHM/journal — not source)
*.db-shm
*.db-wal
*.db-journal

# Lock files
*.lock

# Windows reserved device-name files (cannot be indexed by git on Windows;
# some background service redirects output to these names and drops them as 0-byte files)
nul
con
prn
aux
com1
com2
com3
com4
com5
com6
com7
com8
com9
lpt1
lpt2
lpt3
lpt4
lpt5
lpt6
lpt7
lpt8
lpt9

# Large data caches (exceed GitHub 100MB/file limit; not source)
*.pbf
roktandrazo-outreach/data/osm/
